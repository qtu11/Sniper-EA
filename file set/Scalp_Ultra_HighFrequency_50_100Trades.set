; Preset Ultra High-Frequency Scalping (50 - 150 Lệnh / Ngày Siêu Tốc) cho Sniper EA V4 Production
; Tác giả: Nguyễn Quang Tú (qtusdev)
; Chuyên biệt: Bắt xung lực từng Tick (Intrabar), Hard TP sàn (0ms), Time-Stop 5 phút, Early Exit chống âm
InpAutoTrade=1
InpMagic=990218
InpDeviationPoints=30
InpTradeComment=Sniper_UltraFast
InpSignalMode=0
InpExecutionTiming=1
InpRetestCooldownBars=1
InpMtfMode=1
InpEmaFast=9
InpEmaSlow=21
InpAllowReverseClose=0
InpOnePositionOnly=1

; Bộ lọc độ nhạy cao cho Micro-Scalp
InpUseQualityFilter=1
InpQualityMode=1
InpFilterTF=5
InpFilterATRPeriod=14
InpFilterADXPeriod=14
InpFilterRSIPeriod=14
InpMinADX=10.000000
InpMinEMASepATR=0.040000
InpBuyRSIMin=48.000000
InpBuyRSIMax=72.000000
InpSellRSIMax=52.000000
InpSellRSIMin=28.000000
InpUseCandleFilter=1
InpMaxOppositeWickRatio=0.500000
InpUseEmaSlopeFilter=1
InpUseMaxEmaDistance=1
InpMaxEmaDistanceATR=1.350000
InpUseDailyHighLowFilter=0
InpMinDistanceToDailyHnLR=0.500000
InpUseVWAPFilter=1
InpMinVWAPDistanceATR=0.020000
InpUseVolumeFilter=0
InpVolumePeriod=20
InpMinVolumeRatio=1.050000
InpQualityMinScore=5
InpBlockExtremeVolatility=1
InpExtremeATRRatio=2.500000
InpUseSpreadFilter=0
InpMaxSpreadATRRatio=0.500000
InpUseSpreadSpikeFilter=0
InpSpreadLookbackTicks=30
InpMaxSpreadVsAvgMultiplier=1.500000

; Bộ lọc thời gian (Tắt để chạy 24/5 linh hoạt)
InpUseTimeFilter=0
InpSession1Start=01:00
InpSession1End=11:30
InpUseSession2=0
InpSession2Start=13:30
InpSession2End=21:00
InpUseManualNewsPause=0
InpNewsPauseStart=19:25
InpNewsPauseEnd=20:30
InpTradeMonday=1
InpTradeTuesday=1
InpTradeWednesday=1
InpTradeThursday=1
InpTradeFriday=1
InpTradeSaturday=0
InpTradeSunday=0

; Quản lý vốn Micro-Scalping (Lot nhỏ, quay vòng lệnh nhanh)
InpLotMode=0
InpRiskPercent=1.500000
InpFixedLot=0.010000
InpMaxFixedLotRiskPercent=1.000000
InpMinLot=0.010000
InpMaxLot=5.000000
InpRejectIfMinLotExceedsRisk=1
InpMaxMinLotRiskMultiple=10.000000
InpUseEquity=1
InpMaxDailyLossPercent=10.000000
InpMaxTradesPerDay=0
InpMaxConsecutiveLosses=4
InpUseLossCooldown=1
InpCooldownAfterLossMin=1
InpPauseAfterMaxLossMin=10

; Micro Stop Loss & Micro TP
InpATRTimeframe=1
InpATRPeriod=14
InpATRMultiplier=1.000000
InpSLMode=1
InpSwingBars=4
InpSwingBufferATR=0.250000
InpSLMultiplierR=1.300000
InpMinStopPoints=180
InpTP1_R=0.600000
InpTP2_R=1.200000
InpTP3_R=2.000000
InpTP4_R=3.000000
InpTP5_R=4.500000
InpTP6_R=6.000000

; Chốt 80% tại TP1
InpUsePartialClose=1
InpTP1_ClosePercent=80.000000
InpTP2_ClosePercent=20.000000
InpBreakEvenOnTP1=1
InpBreakEvenMode=0

; Dời SL & Trailing siêu ngắn
InpEnableTrailing=1
InpMoveSL_TP1=1
InpMoveSL_TP2=1
InpMoveSL_TP3=1
InpMoveSL_TP4=1
InpMoveSL_TP5=1
InpMoveSL_TP6=1
InpTrailDistanceR=1.000000
InpTrailUseATRExpansion=1
InpTrailATRExtraR=0.200000

; Bảo hiểm nâng cao & Thoát lệnh thông minh
InpSendHardTPToBroker=1
InpHardTPIndex=0
InpUseTimeStop=1
InpMaxHoldMinutes=5
InpTimeStopOnlyIfLoss=1
InpUseEarlyExitOnReverseBar=1

; Quản lý cuối tuần
InpCloseFriday=1
InpFridayCloseTime=22:00

; Giao diện
InpChartTheme=0
InpShowBidAsk=1
InpShowDashboard=1
InpDashFontSize=1
InpDashboardX=12
InpDashboardY=25
InpLabelFontSize=1
InpLabelOffsetBars=12
InpBarsToDraw=150
InpDrawRibbon=1
InpShowRetest=1
InpRibbonBullColor=13694907
InpRibbonBearColor=13878782
InpShowProfitBox=1
InpShowHistoryDealMarkers=1
InpTimerMilliseconds=500
