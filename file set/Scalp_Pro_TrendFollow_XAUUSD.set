; Preset Đỉnh Cao Scalping Trend-Following & Hold Sóng Vàng (XAUUSD Pro) cho Sniper EA V4 Production
; Tác giả: Nguyễn Quang Tú (qtusdev)
; Triệt tiêu hoàn toàn mua đỉnh bán đáy, SL bọc ngoài Swing Low/High, dời rủi ro từng tầng giữ trọn sóng
InpAutoTrade=1
InpMagic=990217
InpDeviationPoints=30
InpTradeComment=Sniper_XAU_ProTrend
InpSignalMode=2
InpExecutionTiming=0
InpRetestCooldownBars=2
InpMtfMode=1
InpEmaFast=9
InpEmaSlow=21
InpAllowReverseClose=0
InpOnePositionOnly=1

; Bộ lọc chống Sideway & Tối ưu Winrate
InpUseQualityFilter=1
InpQualityMode=1
InpFilterTF=5
InpFilterATRPeriod=14
InpFilterADXPeriod=14
InpFilterRSIPeriod=14
InpMinADX=16.000000
InpMinEMASepATR=0.080000
InpBuyRSIMin=51.000000
InpBuyRSIMax=67.000000
InpSellRSIMax=49.000000
InpSellRSIMin=33.000000
InpUseCandleFilter=1
InpMaxOppositeWickRatio=0.380000
InpUseEmaSlopeFilter=1
InpUseMaxEmaDistance=1
InpMaxEmaDistanceATR=1.200000
InpUseDailyHighLowFilter=1
InpMinDistanceToDailyHnLR=1.000000
InpUseVWAPFilter=1
InpMinVWAPDistanceATR=0.050000
InpUseVolumeFilter=0
InpVolumePeriod=20
InpMinVolumeRatio=1.050000
InpQualityMinScore=8
InpBlockExtremeVolatility=1
InpExtremeATRRatio=2.200000
InpUseSpreadFilter=0
InpMaxSpreadATRRatio=0.500000
InpUseSpreadSpikeFilter=0
InpSpreadLookbackTicks=30
InpMaxSpreadVsAvgMultiplier=1.500000

; Bộ lọc thời gian (Tập trung phiên Âu & Mỹ có biến động xu hướng mạnh)
InpUseTimeFilter=0
InpSession1Start=07:00
InpSession1End=11:30
InpUseSession2=0
InpSession2Start=13:30
InpSession2End=21:00
InpUseManualNewsPause=0
InpNewsPauseStart=19:25
InpNewsPauseEnd=20:30
InpTradeMonday=1
InpTradeTuesday=1
InpTradeWednesday=1
InpTradeThursday=1
InpTradeFriday=1
InpTradeSaturday=0
InpTradeSunday=0

; Quản lý vốn chuyên nghiệp
InpLotMode=0
InpRiskPercent=2.000000
InpFixedLot=0.010000
InpMaxFixedLotRiskPercent=1.000000
InpMinLot=0.010000
InpMaxLot=3.000000
InpRejectIfMinLotExceedsRisk=1
InpMaxMinLotRiskMultiple=10.000000
InpUseEquity=1
InpMaxDailyLossPercent=10.000000
InpMaxTradesPerDay=0
InpMaxConsecutiveLosses=3
InpUseLossCooldown=1
InpCooldownAfterLossMin=3
InpPauseAfterMaxLossMin=20

; Cấu trúc Stop Loss Cấu Trúc Sóng (Swing Low/High + Buffer ATR + Sàn 400 pts)
InpATRTimeframe=1
InpATRPeriod=14
InpATRMultiplier=1.250000
InpSLMode=1
InpSwingBars=8
InpSwingBufferATR=0.400000
InpSLMultiplierR=1.600000
InpMinStopPoints=400
InpTP1_R=1.200000
InpTP2_R=2.200000
InpTP3_R=3.500000
InpTP4_R=5.000000
InpTP5_R=7.000000
InpTP6_R=10.000000

; Chốt lời từng phần & Cơ chế Giảm rủi ro (Chốt 30% tại TP1, chốt 30% tại TP2, 40% ôm trọn trend)
InpUsePartialClose=1
InpTP1_ClosePercent=30.000000
InpTP2_ClosePercent=30.000000
InpBreakEvenOnTP1=1
InpBreakEvenMode=1

; Dời SL & Trailing
InpEnableTrailing=1
InpMoveSL_TP1=1
InpMoveSL_TP2=1
InpMoveSL_TP3=1
InpMoveSL_TP4=1
InpMoveSL_TP5=1
InpMoveSL_TP6=1
InpTrailDistanceR=1.800000
InpTrailUseATRExpansion=1
InpTrailATRExtraR=0.350000

; Bảo hiểm nâng cao & Thoát lệnh thông minh
InpSendHardTPToBroker=0
InpHardTPIndex=0
InpUseTimeStop=1
InpMaxHoldMinutes=15
InpTimeStopOnlyIfLoss=1
InpUseEarlyExitOnReverseBar=1

; Quản lý cuối tuần
InpCloseFriday=1
