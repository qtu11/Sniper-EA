; ==============================================================================
; PRESET INSTITUTIONAL SWING HOLD - MẠO HIỂM LỢI NHUẬN CAO (AGGRESSIVE HIGH RETURN)
; Tác giả: Nguyễn Quang Tú (qtusdev) - System Architect & Trading Quant
; Mục tiêu: Tối đa hóa tỷ suất sinh lời, tăng tần suất bắt sóng, Rủi ro 2.5% - 3.0%/lệnh
; Đặc tính:
;   1. Tắt chặn ngược HTF Bias -> Bắt cả sóng đảo chiều lẫn sóng hồi sâu từ đáy/đỉnh
;   2. Hạ Min Room xuống 1.8R -> Tăng gấp đôi số lượng cơ hội vào lệnh trong tuần
;   3. Điểm vào nhạy hơn: Retrace 40% FVG + Micro M1 Rejection Close -> Khớp ngay chân sóng
;   4. Giữ 60% Runner thả nổi -> Chỉ cần 1-2 lệnh ăn sóng 200-300 pips là tài khoản x2 x3!
; ==============================================================================
InpStrategyEngine=1
InpPurePriceActionOnly=1
InpUseHTFBias=1
InpHTFBiasTF=16385
InpFilterAgainstHTFBias=0
InpHTFLocationTF=15
InpRangeLookbackBars=45
InpSetupTF=5
InpSweepLookbackBars=20
InpEqualLevelToleranceATR=0.120000
InpMinDisplacementATR=1.100000
InpMinDisplacementBodyRatio=0.600000
InpMinRoomRewardRatio=1.800000
InpPivotStrength=1
InpSetupType=0
InpEntryTF=1
InpRequireFvgRetest=1
InpMaxRetestWaitBars=10
InpFvgRetraceRatio=0.400000
InpEntryConfirmation=2
InpMicroBouncePts=10.000000
InpMinRejectWickRatio=0.200000
InpStructureTrailBars=15
InpInvalidationBufferPts=15.000000
InpUseStructureTrailing=1
InpHoldFridayForInstitutional=1

; [CẤU HÌNH CỐT LÕI]
InpAutoTrade=1
