; Preset Hold Lệnh Dài Tối Ưu (Swing / Big Trend Following Pro) cho Sniper EA V4 Production
; Tác giả: Nguyễn Quang Tú (qtusdev)
; Khuyên dùng: Gắn vào Chart M5 hoặc M15 của XAUUSD / Forex để ôm trọn sóng lớn 150 - 400 pips
; Đã tháo gỡ nút thắt cổ chai Hard Gates -> Mở lệnh mượt mà khi xu hướng hình thành
InpAutoTrade=1
InpMagic=990216
InpDeviationPoints=30
InpTradeComment=Sniper_SwingPro
InpSignalMode=0
InpExecutionTiming=0
InpRetestCooldownBars=3
InpMtfMode=1
InpEmaFast=9
InpEmaSlow=21
InpAllowReverseClose=0
InpOnePositionOnly=1

; Bộ lọc chất lượng xu hướng lớn (Score-based thông minh, không kẹt lệnh)
InpUseQualityFilter=1
InpQualityMode=1
InpFilterTF=15
InpFilterATRPeriod=14
InpFilterADXPeriod=14
InpFilterRSIPeriod=14
InpMinADX=16.000000
InpMinEMASepATR=0.080000
InpBuyRSIMin=50.000000
InpBuyRSIMax=68.000000
InpSellRSIMax=50.000000
InpSellRSIMin=32.000000
InpUseCandleFilter=1
InpMaxOppositeWickRatio=0.400000
InpUseEmaSlopeFilter=1
InpUseMaxEmaDistance=1
InpMaxEmaDistanceATR=1.400000
InpUseDailyHighLowFilter=1
InpMinDistanceToDailyHnLR=0.800000
InpUseVWAPFilter=1
InpMinVWAPDistanceATR=0.050000
InpUseVolumeFilter=0
InpVolumePeriod=20
InpMinVolumeRatio=1.050000
InpQualityMinScore=8
InpBlockExtremeVolatility=1
InpExtremeATRRatio=2.500000
InpUseSpreadFilter=0
InpMaxSpreadATRRatio=0.500000
InpUseSpreadSpikeFilter=0
InpSpreadLookbackTicks=30
InpMaxSpreadVsAvgMultiplier=1.500000

; Bộ lọc thời gian (Tắt mặc định để tương thích 100% mọi múi giờ của các sàn Broker)
InpUseTimeFilter=0
InpSession1Start=07:00
InpSession1End=21:00
InpUseSession2=0
InpSession2Start=13:30
InpSession2End=21:00
InpUseManualNewsPause=0
InpNewsPauseStart=19:25
InpNewsPauseEnd=20:30
InpTradeMonday=1
InpTradeTuesday=1
InpTradeWednesday=1
InpTradeThursday=1
InpTradeFriday=1
InpTradeSaturday=0
InpTradeSunday=0

; Quản lý vốn Swing an toàn
InpLotMode=0
InpRiskPercent=2.000000
InpFixedLot=0.010000
InpMaxFixedLotRiskPercent=1.000000
InpMinLot=0.010000
InpMaxLot=5.000000
InpRejectIfMinLotExceedsRisk=1
InpMaxMinLotRiskMultiple=10.000000
InpUseEquity=1
InpMaxDailyLossPercent=10.000000
InpMaxTradesPerDay=5
InpMaxConsecutiveLosses=2
InpUseLossCooldown=1
InpCooldownAfterLossMin=5
InpPauseAfterMaxLossMin=20

; Cấu trúc Stop Loss Cấu Trúc Swing M5 + Sàn 450 pts (45 pips)
InpATRTimeframe=5
InpATRPeriod=14
InpATRMultiplier=1.400000
InpSLMode=1
InpSwingBars=10
InpSwingBufferATR=0.450000
InpSLMultiplierR=1.600000
InpMinStopPoints=450
InpTP1_R=1.500000
InpTP2_R=3.000000
InpTP3_R=5.000000
InpTP4_R=8.000000
InpTP5_R=12.000000
InpTP6_R=16.000000

; Chốt lời từng phần & Cơ chế Dời rủi ro (Chốt 25% tại TP1, 25% tại TP2, giữ 50% chạy hết sóng)
InpUsePartialClose=1
InpTP1_ClosePercent=25.000000
InpTP2_ClosePercent=25.000000
InpBreakEvenOnTP1=1
InpBreakEvenMode=2

; Dời SL & Trailing ôm trọn trend
InpEnableTrailing=1
InpMoveSL_TP1=0
InpMoveSL_TP2=1
InpMoveSL_TP3=1
InpMoveSL_TP4=1
InpMoveSL_TP5=1
InpMoveSL_TP6=1
InpTrailDistanceR=2.200000
InpTrailUseATRExpansion=1
InpTrailATRExtraR=0.400000

; Quản lý cuối tuần
InpCloseFriday=1
InpFridayCloseTime=21:00

; Giao diện
InpChartTheme=0
InpShowBidAsk=1
InpShowDashboard=1
InpDashFontSize=1
InpDashboardX=12
InpDashboardY=25
InpLabelFontSize=1
InpLabelOffsetBars=12
InpBarsToDraw=150
InpDrawRibbon=1
InpShowRetest=1
InpRibbonBullColor=13694907
InpRibbonBearColor=13878782
InpShowProfitBox=1
InpShowHistoryDealMarkers=1
InpTimerMilliseconds=500
