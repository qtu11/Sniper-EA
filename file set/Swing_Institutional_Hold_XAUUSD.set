; ==============================================================================
; PRESET HOLD LỆNH DÀI ĂN SÂU: INSTITUTIONAL PRICE ACTION & LIQUIDITY (XAUUSD)
; Tác giả: Nguyễn Quang Tú (qtusdev) - System Architect & Trading Quant
; Triết lý: "Vào gần nơi sai (Invalidation), không vào giữa đường. Phía trước còn Room lớn mới vào."
; Quy trình 6 bước chuẩn định chế:
;   1. HTF Location: Giá phải ở Discount Zone để BUY, Premium Zone để SELL (Khung M15)
;   2. Liquidity Sweep: Quét sạch bể thanh khoản đỉnh/đáy cũ (EQH/EQL) rồi rút râu bẫy giá
;   3. Displacement: Nến bung xung lực mạnh (Body >= 65%, biên độ >= 1.25 ATR) phá vỡ cấu trúc (MSS/BOS)
;   4. FVG Retest: Tạo vùng Fair Value Gap (FVG) và kiên nhẫn chờ giá Pullback retest (chống đu đỉnh nến bung)
;   5. Room to Target: Khoảng trống từ FVG đến Major Liquidity đối diện phải >= 2.5x rủi ro
;   6. True Pivot Trailing: Dời SL nấp sau True Pivot Higher Low (Buy) hoặc Lower High (Sell) để ăn trọn sóng lớn 100-300 pips!
; ==============================================================================
InpStrategyEngine=1
InpPurePriceActionOnly=1
InpUseHTFBias=1
InpHTFBiasTF=16385
InpFilterAgainstHTFBias=1
InpHTFLocationTF=15
InpRangeLookbackBars=60
InpSetupTF=5
InpSweepLookbackBars=30
InpEqualLevelToleranceATR=0.100000
InpMinDisplacementATR=1.250000
InpMinDisplacementBodyRatio=0.650000
InpMinRoomRewardRatio=2.500000
InpPivotStrength=2
InpSetupType=0
InpEntryTF=1
InpRequireFvgRetest=1
InpMaxRetestWaitBars=8
InpFvgRetraceRatio=0.500000
InpEntryConfirmation=3
InpMicroBouncePts=15.000000
InpMinRejectWickRatio=0.250000
InpStructureTrailBars=20
InpInvalidationBufferPts=20.000000
InpUseStructureTrailing=1
InpHoldFridayForInstitutional=1

; [CẤU HÌNH CỐT LÕI]
InpAutoTrade=1
InpMagic=990235
InpDeviationPoints=30
InpTradeComment=Sniper_Institutional
InpSignalMode=0
InpExecutionTiming=0
InpRetestCooldownBars=2
InpMtfMode=1
InpEmaFast=9
InpEmaSlow=21
InpAllowReverseClose=1
InpOnePositionOnly=1

; [BỘ LỌC XU HƯỚNG NỀN TẢNG]
InpUseBaselineTrend=0
InpBaselinePeriod=200
InpBlockClimaxCandles=0
InpMaxSignalCandleATR=1.800000

; [QUẢN LÝ VỐN: LOT THEO VỐN]
InpLotMode=0
InpRiskPercent=1.000000
InpAutoLotBalanceStep=500.000000
InpFixedLot=0.010000
InpMaxFixedLotRiskPercent=1.000000
InpMinLot=0.010000
InpMaxLot=5.000000
InpRejectIfMinLotExceedsRisk=1
InpMaxMinLotRiskMultiple=10.000000
InpUseEquity=1
InpMaxDailyLossPercent=10.000000
InpMaxTradesPerDay=0
InpMaxConsecutiveLosses=3
InpUseLossCooldown=1
InpCooldownAfterLossMin=5
InpPauseAfterMaxLossMin=30

; [STOP LOSS & CÁC MỐC TP CHO HOLD DÀI]
InpATRTimeframe=5
InpATRPeriod=14
InpATRMultiplier=1.000000
InpSLMode=1
InpSwingBars=6
InpSwingBufferATR=0.300000
InpSLMultiplierR=1.000000
InpMinStopPoints=160
InpTP1_R=2.000000
InpTP2_R=4.500000
InpTP3_R=7.000000
InpTP4_R=10.000000
InpTP5_R=15.000000
InpTP6_R=20.000000

; [CHỐT LỜI TỪNG PHẦN]
InpUsePartialClose=1
InpTP1_ClosePercent=25.000000
InpTP2_ClosePercent=25.000000
InpBreakEvenOnTP1=1
InpBreakEvenMode=0

; [DỜI STOP LOSS & TRAILING]
InpEnableTrailing=1
InpMoveSL_TP1=1
InpMoveSL_TP2=1
InpMoveSL_TP3=1
InpMoveSL_TP4=1
InpMoveSL_TP5=1
InpMoveSL_TP6=1
InpTrailDistanceR=1.500000
InpTrailUseATRExpansion=1
InpTrailATRExtraR=0.300000

; [BẢO HIỂM THOÁT SỚM & DỜI SL DƯƠNG RÕ RỆT]
InpSendHardTPToBroker=0
InpHardTPIndex=0
InpUseTimeStop=0
InpMaxHoldMinutes=120
InpTimeStopOnlyIfLoss=1
InpUseEarlyExitOnReverseBar=0
InpUseMidWayBE=0
InpMidWayRatio=0.500000
InpMidWayLockRatio=0.250000
